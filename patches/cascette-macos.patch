diff --git a/tests/test_core/test_large_local_index.py b/tests/test_core/test_large_local_index.py
new file mode 100644
index 0000000..00f87dd
--- /dev/null
+++ b/tests/test_core/test_large_local_index.py
@@ -0,0 +1,46 @@
+"""Large installs must retain writable update pages in every KMT bucket."""
+
+from pathlib import Path
+
+from cascette_tools.core.local_storage import (
+    IDX_FILE_SIZE,
+    UPDATE_SECTION_MIN_SIZE,
+    LocalIndexEntry,
+    LocalStorage,
+    parse_local_idx_file,
+)
+
+
+def test_large_sorted_section_retains_update_capacity(tmp_path: Path):
+    storage = LocalStorage(tmp_path)
+    storage.initialize()
+    entries = [
+        LocalIndexEntry(
+            key=i.to_bytes(9, "big"),
+            archive_id=0,
+            archive_offset=480 + i * 100,
+            size=100,
+        )
+        for i in range(1, 14001)
+    ]
+    storage.bucket_entries[0] = entries
+    storage.flush_indices()
+    path = storage.data_path / "0000000001.idx"
+    data = path.read_bytes()
+    sorted_end = 40 + int.from_bytes(data[32:36], "little")
+    assert sorted_end > IDX_FILE_SIZE
+    update_start = (sorted_end + 4095) & ~4095
+    assert len(data) - update_start >= UPDATE_SECTION_MIN_SIZE
+    assert not any(data[update_start:])
+    assert parse_local_idx_file(data).entries == entries
+
+    addition = LocalIndexEntry(
+        key=b"\xff" * 9, archive_id=1, archive_offset=480, size=70
+    )
+    original_size = path.stat().st_size
+    storage.insert_entry(0, addition)
+    assert path.stat().st_size == original_size
+    parsed = parse_local_idx_file(path.read_bytes())
+    assert parsed.entries == entries
+    assert len(parsed.update_entries) == 1
+    assert parsed.update_entries[0].key == addition.key
